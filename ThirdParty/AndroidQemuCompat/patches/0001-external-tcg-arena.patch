+/* AndroidEmu: the host owns the prepared RX/RW mappings for the whole VM.
+ * Registration is allowed only before QEMU initialization on the launch thread.
+ */
+static void *android51_tcg_rw;
+static void *android51_tcg_rx;
+static size_t android51_tcg_bytes;
+static bool android51_tcg_initialized;
+
+bool android51_tcg_set_region(void *rw, void *rx, size_t bytes);
+bool android51_tcg_set_region(void *rw, void *rx, size_t bytes)
+{
+    size_t page = qemu_real_host_page_size();
+    uintptr_t w = (uintptr_t)rw, x = (uintptr_t)rx;
+    if (android51_tcg_initialized || android51_tcg_rw || !w || !x ||
+        w == x || w % page || x % page || bytes % page ||
+        bytes < MIN_CODE_GEN_BUFFER_SIZE || bytes > MAX_CODE_GEN_BUFFER_SIZE ||
+        bytes > UINTPTR_MAX - w || bytes > UINTPTR_MAX - x ||
+        (w < x ? x - w : w - x) < bytes) {
+        return false;
+    }
+    android51_tcg_rw = rw;
+    android51_tcg_rx = rx;
+    android51_tcg_bytes = bytes;
+    return true;
+}
